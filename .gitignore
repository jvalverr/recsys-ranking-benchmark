# ============================================================
# Recommender Benchmark: Datasets
# ============================================================

# Original datasets remain outside Git because they may be
# large and subject to source-specific redistribution terms.
# These rules cover MovieLens, RetailRocket, and Amazon data.
/data/raw/
/data/external/

# Generated datasets remain local because the preparation
# pipeline can reproduce them from the original sources.
/data/interim/
/data/processed/
/data/cache/
/data/tmp/

# Small synthetic test fixtures remain versionable under
# tests/fixtures/ to support automated reproducibility.

# ============================================================
# Recommender Benchmark: Models and experiments
# ============================================================

# Trained models and experiment artifacts remain outside Git
# because they can be regenerated by the training pipeline.
/artifacts/
/models/checkpoints/
/models/artifacts/
/outputs/

# Experiment trackers store local runs and model artifacts
# separately from the source code.
/mlruns/
/mlartifacts/
/wandb/

# Temporary reports remain untracked, while curated Markdown
# reports and selected figures remain available for publication.
/reports/generated/

# Application logs and temporary working files
/logs/
/tmp/
/scratch/
